MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=receipt_issuer
# Who may administer the platform. Comma-separated Google account addresses.
# This is the whole access list: there is no admin password and no bootstrap
# script. Adding or removing someone is an edit here (or in the hosting
# dashboard's environment variables), and it takes effect on their next request.
# PLATFORM_ADMIN_EMAILS=you@example.com,colleague@example.com

# Google OAuth client for /admin/login. Create one at
# https://console.cloud.google.com/apis/credentials with the authorised redirect
# URI <your origin>/api/admin/auth/google/callback
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...

# Stripe's webhook signing secret (Developers → Webhooks → the endpoint's
# "Signing secret"). Without it, /api/stripe/webhook answers 503 and records
# nothing. RE-Biz only receives events, so no Stripe API key is needed or used.
# STRIPE_WEBHOOK_SECRET=whsec_...
