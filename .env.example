MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DB=receipt_issuer
# Optional platform-admin bootstrap, applied only the first time
# `npm run db:migrate` runs. Once that migration is recorded in
# schemaMigrations it never runs again, so setting this afterwards does
# nothing — use `npm run db:grant-super-admin -- <email>` instead.
# SUPER_ADMIN_EMAILS=admin@example.com
